@* File    : Dashboard.razor
   Purpose : Trang chủ end-user (Tổng quan). Khung — sẽ gắn KPI/widget theo module sau. *@

@page "/"
@inherits LocalizedComponentBase

<PageTitle>@Loc.L("nav.dashboard", "Tổng quan") — ICare247</PageTitle>

<div class="page-header">
    <h1>@Loc.L("nav.dashboard", "Tổng quan")</h1>
    <p class="page-header__sub">@Loc.L("dashboard.welcome", "Chào mừng đến ICare247. Chọn một phân hệ ở thanh điều hướng để bắt đầu.")</p>
</div>

@* WEB-UX Finding B: bỏ KPI rỗng "—" (đi ngược "không dashboard nếu không cần"), thay bằng thẻ
   lối tắt vào thẳng phân hệ (nguồn AppNav → nhãn qua Loc.L). KPI thật để dành phase báo cáo. *@
<div class="quick-grid">
    @foreach (var m in AppNav.Modules)
    {
        <NavLink class="quick-card" href="@($"m/{m.Key}")">
            <span class="quick-card__icon"><Icon Name="@m.Icon" Size="22" /></span>
            <span class="quick-card__label">@Loc.L(NavKeys.Module(m.Key), m.Title)</span>
        </NavLink>
    }
</div>
