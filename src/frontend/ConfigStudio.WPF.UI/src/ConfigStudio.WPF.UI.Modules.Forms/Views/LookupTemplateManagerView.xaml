<UserControl x:Class="ConfigStudio.WPF.UI.Modules.Forms.Views.LookupTemplateManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:text="clr-namespace:ConfigStudio.WPF.UI.Core.Constants;assembly=ConfigStudio.WPF.UI.Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="760"
             d:DesignWidth="1280"
             mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource ShellContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource AppCommandBarHostStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{x:Static text:LookupTemplateUiText.ScreenTitle}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Text="{x:Static text:LookupTemplateUiText.ScreenSubtitle}"
                               FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{x:Static text:LookupTemplateUiText.Refresh}"
                            Command="{Binding RefreshCommand}"
                            Style="{DynamicResource AppOutlineButtonStyle}"
                            ToolTip="{x:Static text:LookupTemplateUiText.TipRefresh}"
                            Margin="0,0,8,0" />
                    <Button Content="{x:Static text:LookupTemplateUiText.New}"
                            Command="{Binding NewCommand}"
                            Style="{DynamicResource AppActionButtonStyle}"
                            ToolTip="{x:Static text:LookupTemplateUiText.TipNew}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Text="{x:Static text:LookupTemplateUiText.ListTitle}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextBrush}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static text:LookupTemplateUiText.Edit}"
                            Command="{Binding EditCommand}"
                            Style="{DynamicResource AppOutlineButtonStyle}"
                            ToolTip="{x:Static text:LookupTemplateUiText.TipEdit}" Margin="0,0,8,0" />
                    <Button Content="{x:Static text:LookupTemplateUiText.Delete}"
                            Command="{Binding DeleteCommand}"
                            Style="{DynamicResource AppOutlineButtonStyle}"
                            Foreground="{DynamicResource AppDangerBrush}"
                            ToolTip="{x:Static text:LookupTemplateUiText.TipDeleteList}" />
                </StackPanel>
            </DockPanel>

            <dxg:GridControl Grid.Row="1" ItemsSource="{Binding Templates}"
                             SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                             AutoGenerateColumns="None">
                <dxg:GridControl.View>
                    <dxg:TableView NavigationStyle="Row" AllowEditing="False"
                                   ShowAutoFilterRow="True"
                                   RowDoubleClick="OnRowDoubleClick" />
                </dxg:GridControl.View>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header="{x:Static text:LookupTemplateUiText.TemplateCode}"
                                    FieldName="TemplateCode" Width="200" AutoFilterCondition="Contains" />
                    <dxg:GridColumn Header="{x:Static text:LookupTemplateUiText.Name}"
                                    FieldName="Ten" Width="*" AutoFilterCondition="Contains" />
                    <dxg:GridColumn Header="{x:Static text:LookupTemplateUiText.QueryMode}"
                                    FieldName="QueryMode" Width="110" AutoFilterCondition="Contains" />
                    <dxg:GridColumn Header="{x:Static text:LookupTemplateUiText.Active}"
                                    FieldName="IsActive" Width="90" />
                    <dxg:GridColumn Header="{x:Static text:LookupTemplateUiText.System}"
                                    FieldName="IsSystem" Width="90" />
                </dxg:GridControl.Columns>
            </dxg:GridControl>

            <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,8"
                    Style="{DynamicResource AppStatusBannerStyle}"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Style="{DynamicResource AppStatusTextStyle}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
