<UserControl x:Class="ConfigStudio.WPF.UI.Modules.Forms.Views.MaRuleManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:text="clr-namespace:ConfigStudio.WPF.UI.Core.Constants;assembly=ConfigStudio.WPF.UI.Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="780"
             d:DesignWidth="1320"
             mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding NewCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource ShellContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource AppCommandBarHostStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{x:Static text:MaRuleUiText.ScreenTitle}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextBrush}" />
                    <TextBlock Text="{x:Static text:MaRuleUiText.ScreenSubtitle}"
                               FontSize="12" Foreground="{DynamicResource AppTextMutedBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{x:Static text:MaRuleUiText.Refresh}"
                            Command="{Binding RefreshCommand}"
                            Style="{DynamicResource AppOutlineButtonStyle}"
                            ToolTip="{x:Static text:MaRuleUiText.TipRefresh}"
                            Margin="0,0,8,0" />
                    <Button Content="{x:Static text:MaRuleUiText.New}"
                            Command="{Binding NewCommand}"
                            Style="{DynamicResource AppActionButtonStyle}"
                            ToolTip="{x:Static text:MaRuleUiText.TipNew}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left" Text="{x:Static text:MaRuleUiText.ListTitle}"
                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextBrush}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static text:MaRuleUiText.Edit}"
                            Command="{Binding EditCommand}"
                            Style="{DynamicResource AppOutlineButtonStyle}"
                            ToolTip="{x:Static text:MaRuleUiText.TipEdit}" Margin="0,0,8,0" />
                    <Button Content="{x:Static text:MaRuleUiText.Delete}"
                            Command="{Binding DeleteCommand}"
                            Style="{DynamicResource AppOutlineButtonStyle}"
                            Foreground="{DynamicResource AppDangerBrush}"
                            ToolTip="{x:Static text:MaRuleUiText.TipDeleteList}" />
                </StackPanel>
            </DockPanel>

            <dxg:GridControl Grid.Row="1" ItemsSource="{Binding Rules}"
                             SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                             AutoGenerateColumns="None">
                <dxg:GridControl.View>
                    <dxg:TableView NavigationStyle="Row" AllowEditing="False"
                                   ShowAutoFilterRow="True"
                                   RowDoubleClick="OnRowDoubleClick" />
                </dxg:GridControl.View>
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header="{x:Static text:MaRuleUiText.TargetTable}"
                                    FieldName="TableCode" Width="*" AutoFilterCondition="Contains" />
                    <dxg:GridColumn Header="{x:Static text:MaRuleUiText.TargetColumn}"
                                    FieldName="ColumnCode" Width="120" AutoFilterCondition="Contains" />
                    <dxg:GridColumn Header="{x:Static text:MaRuleUiText.PreviewCodeColumn}"
                                    FieldName="PreviewCode" Width="160" AutoFilterCondition="Contains"
                                    ToolTip="{x:Static text:MaRuleUiText.TipPreviewCodeColumn}">
                        <dxg:GridColumn.CellStyle>
                            <Style TargetType="dxg:LightweightCellEditor">
                                <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
                            </Style>
                        </dxg:GridColumn.CellStyle>
                    </dxg:GridColumn>
                    <dxg:GridColumn Header="{x:Static text:MaRuleUiText.Active}"
                                    FieldName="IsActive" Width="90" />
                    <dxg:GridColumn Header="{x:Static text:MaRuleUiText.System}"
                                    FieldName="IsSystem" Width="110" />
                </dxg:GridControl.Columns>
            </dxg:GridControl>

            <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,8"
                    Style="{DynamicResource AppStatusBannerStyle}"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Style="{DynamicResource AppStatusTextStyle}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
